# ============================================================
#  Frontend — modèle de configuration (.env)
#  Usage : cp .env.example .env
#  Variables préfixées VITE_ exposées au navigateur.
# ============================================================

# URL de base de l'API Django (slash final non requis)
VITE_API_URL=/api

# Mocks MSW : true = données fictives (aucun backend requis),
#             false = vrai backend sur VITE_API_URL
VITE_USE_MOCK=true
