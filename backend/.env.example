# ============================================================
#  Backend — modèle de configuration (.env)
#  Usage : cp .env.example .env  puis renseigner les valeurs.
#  Ce fichier est versionné ; .env réel est ignoré par Git.
# ============================================================

# ---------- Django ----------
DJANGO_SECRET_KEY=changez-moi-generez-une-cle-secrete
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origines autorisées pour CSRF (frontend Vite en développement)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- MySQL 8 ----------
DB_NAME=gestion_ventes
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
